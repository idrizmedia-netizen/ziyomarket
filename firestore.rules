rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Sotuvchi: sellers to'plamida bo'lgan yoki admin bo'lgan har kim
    function isSeller() {
      return isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/sellers/$(request.auth.token.email)));
    }

    // Everyone can see categories and products; only admins can change them
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // admins can edit anything; sellers can only fulfill orders (which
      // decreases qty) so we allow them to update qty specifically
      allow update: if isAdmin() ||
        (isSeller() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty']));
    }

    // Orders: a signed-in user can create their own order (status must start
    // as 'pending', stock is NOT touched yet). Buyer can read their own
    // orders; sellers/admins can read and update (fulfill/cancel) any order.
    match /orders/{orderId} {
      allow create: if isSignedIn() &&
        request.resource.data.buyerUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isSignedIn() &&
        (resource.data.buyerUid == request.auth.uid || isSeller());
      allow update: if isSeller();
      allow delete: if false;
    }

    // Admin allow-list: document ID = admin's email.
    // Only existing admins can view the list or add/remove other admins.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Seller allow-list: document ID = seller's email.
    // Only admins can manage who is a seller.
    match /sellers/{email} {
      allow read: if isSeller();
      allow write: if isAdmin();
    }
  }
}
