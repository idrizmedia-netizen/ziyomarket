rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Sotuvchi: sellers to'plamida bo'lgan yoki admin bo'lgan har kim
    function isSeller() {
      return isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/sellers/$(request.auth.token.email)));
    }

    // Everyone can see categories and products; only admins can change them
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bildirishnomalar: hammaga ko'rinadi, faqat admin yoza oladi
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reklama karuseli va sozlamalar: hammaga ko'rinadi, faqat admin yoza oladi
    match /ads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // admins can edit anything; sellers can only fulfill orders (which
      // decreases qty); any signed-in user can update rating fields when
      // leaving a review
      allow update: if isAdmin() ||
        (isSeller() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty','soldCount'])) ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum','ratingCount']));
    }

    // Sharhlar: hammaga ko'rinadi, faqat o'z nomidan yoza oladi, o'zgartirib/
    // o'chirib bo'lmaydi (halollikni saqlash uchun)
    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.buyerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Orders: a signed-in user can create their own pending order (app orqali
    // buyurtma). Sotuvchi/admin esa do'konda darhol yakunlangan (POS) sotuv
    // yozib qo'ya oladi. Buyer o'z buyurtmalarini, sotuvchi/admin barchasini
    // o'qiy oladi; yakunlash/bekor qilish faqat sotuvchi/admin qo'lida.
    match /orders/{orderId} {
      allow create: if
        (isSignedIn() &&
         request.resource.data.buyerUid == request.auth.uid &&
         request.resource.data.status == 'pending') ||
        (isSeller() &&
         request.resource.data.status == 'fulfilled' &&
         request.resource.data.source == 'pos');
      allow read: if isSignedIn() &&
        (resource.data.buyerUid == request.auth.uid || isSeller());
      allow update: if isSeller() ||
        (isSignedIn() &&
         resource.data.buyerUid == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt']));
      allow delete: if false;
    }

    // Admin allow-list: document ID = admin's email.
    // Only existing admins can view the list or add/remove other admins.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Seller allow-list: document ID = seller's email.
    // Only admins can manage who is a seller.
    match /sellers/{email} {
      allow read: if isSeller();
      allow write: if isAdmin();
    }
  }
}
